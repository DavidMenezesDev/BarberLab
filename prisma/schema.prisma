generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  BARBER_ADMIN
  SUPER_ADMIN
}

enum StaffRole {
  OWNER
  BARBER
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum WhatsAppMessageStatus {
  SENT
  FAILED
  SKIPPED
}

enum WhatsAppProvider {
  WAHA
  UAZAPI
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  barbers          Barber[]
  phone            String?
  role             Role               @default(CUSTOMER)
  onboardingDoneAt DateTime?
  // Conta bloqueada pela plataforma: não entra e a sessão aberta deixa de valer.
  disabledAt       DateTime?
  memberships      BarbershopMember[]
  accounts         Account[]
  sessions         Session[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Vínculo entre quem administra e cada unidade, com o papel naquela unidade.
model BarbershopMember {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  staffRole    StaffRole
  createdAt    DateTime   @default(now())

  @@unique([userId, barbershopId])
  @@index([barbershopId])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String
  email     String?
  birthDate DateTime? @db.Date
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model OpeningHour {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  weekday      Int
  opensAt      String
  closesAt     String
  isClosed     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([barbershopId, weekday])
  @@index([barbershopId])
}

model Barbershop {
  id               String              @id @default(uuid())
  name             String
  slug             String              @unique
  address          String
  city             String?
  document         String?
  phones           String[]
  description      String
  features         String[]            @default(["Wi-Fi Gratuito", "Estacionamento", "Cartão de Crédito", "Produtos Premium", "Ambiente Climatizado", "Profissionais Qualificados"])
  imageUrl         String
  logoUrl          String?
  // Aparência da página pública (cores e fontes), validada em app/_lib/theme.ts.
  theme            Json?
  // Sem plano a barbearia não tem restrição (instalações antigas e single-tenant).
  planId           String?
  plan             Plan?               @relation(fields: [planId], references: [id], onDelete: SetNull)
  // Suspensa pela plataforma: sai do catálogo e não recebe agendamentos.
  suspendedAt      DateTime?
  // Exceções ao plano, por funcionalidade: { "appearance": false }.
  featureOverrides Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  services         BarbershopService[]
  members          BarbershopMember[]
  groupId          String?
  group            BarbershopGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  blocks           ScheduleBlock[]
  openingHours     OpeningHour[]
  barbers          Barber[]
  invites          StaffInvite[]
  whatsapp         WhatsAppConnection?

  @@index([groupId])
  @@index([planId])
}

// Plano comercial: preço, limites e as funcionalidades liberadas (chaves de
// app/_lib/features.ts). Limite nulo significa ilimitado.
model Plan {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  description  String       @default("")
  priceMonthly Decimal      @default(0) @db.Decimal(10, 2)
  priceYearly  Decimal?     @db.Decimal(10, 2)
  maxUnits     Int?
  maxBarbers   Int?
  features     String[]
  isActive     Boolean      @default(true)
  // Plano que as barbearias novas recebem no cadastro.
  isDefault    Boolean      @default(false)
  sortOrder    Int          @default(0)
  barbershops  Barbershop[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Marca com várias unidades: o link público dela leva à escolha da unidade.
model BarbershopGroup {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  barbershops Barbershop[]
}

model StaffInvite {
  id           String     @id @default(cuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  email        String
  token        String     @unique
  role         StaffRole  @default(BARBER)
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([barbershopId])
}

model Barber {
  id           String     @id @default(uuid())
  name         String
  specialty    String?
  imageUrl     String?
  isActive     Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings     Booking[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([barbershopId, userId])
  @@index([barbershopId, isActive])
  @@index([userId])
}

model BarbershopService {
  id              String     @id @default(uuid())
  name            String
  description     String
  imageUrl        String
  price           Decimal    @db.Decimal(10, 2)
  durationMinutes Int        @default(45)
  isActive        Boolean    @default(true)
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([barbershopId, isActive])
}

model Booking {
  id         String            @id @default(uuid())
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  serviceId  String
  service    BarbershopService @relation(fields: [serviceId], references: [id])
  barberId   String?
  barber     Barber?           @relation(fields: [barberId], references: [id], onDelete: SetNull)
  date       DateTime
  status     BookingStatus     @default(CONFIRMED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([serviceId, date])
  @@index([customerId, date])
  @@index([barberId, date])
}

model ScheduleBlock {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([barbershopId, startsAt])
}

// Número de WhatsApp ligado a um provedor (WAHA ou UAZAPI), gerido pela
// plataforma. Com barbershopId é o número externo daquela barbearia; sem ele é
// o número do sistema, usado por quem não tem um próprio (só um é o padrão).
model WhatsAppConnection {
  id            String               @id @default(uuid())
  name          String
  provider      WhatsAppProvider
  baseUrl       String
  // Chave da API (WAHA) ou admintoken (UAZAPI), cifrada em app/_lib/secret.ts.
  apiKey        String
  // Sessão (WAHA) ou instância (UAZAPI) criada no provedor.
  sessionName   String
  // Token da instância; só o UAZAPI usa. Cifrado.
  instanceToken String?
  // Número conectado, só dígitos, preenchido quando a conexão se confirma.
  phone         String?
  enabled       Boolean              @default(true)
  isDefault     Boolean              @default(false)
  barbershopId  String?              @unique
  barbershop    Barbershop?          @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  logs          WhatsAppMessageLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Histórico de envios, visível só ao super admin. Guarda nomes e telefone como
// estavam na hora, então sobrevive à exclusão da conexão ou do agendamento.
model WhatsAppMessageLog {
  id             String                @id @default(uuid())
  kind           String
  status         WhatsAppMessageStatus
  // Motivo da falha ou do não envio.
  error          String?
  phone          String?
  body           String?
  bookingId      String?
  barbershopName String?
  connectionId   String?
  connection     WhatsAppConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionName String?
  createdAt      DateTime              @default(now())

  @@index([createdAt])
  @@index([bookingId])
}

model RateLimit {
  key    String  @id @db.VarChar(255)
  points Int     @default(0)
  expire BigInt?
}

model Image {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  size        Int
  createdAt   DateTime @default(now())
}
